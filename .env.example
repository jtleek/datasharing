# Application Settings
APP_NAME="Brazilian Federal Data Collector SaaS"
APP_VERSION="1.0.0"
ENVIRONMENT=development
DEBUG=True
API_V1_PREFIX=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Database
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/datasharing
DATABASE_POOL_SIZE=20
DATABASE_MAX_OVERFLOW=0

# Redis
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL=3600

# Celery
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# Security
SECRET_KEY=your-super-secret-key-change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# API Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Brazilian Data Sources
DADOS_GOV_BR_BASE_URL=https://dados.gov.br
PORTAL_TRANSPARENCIA_BASE_URL=https://api.portaldatransparencia.gov.br/api-de-dados
IBGE_API_BASE_URL=https://servicodados.ibge.gov.br/api/v3

# Data Storage
DATA_STORAGE_PATH=/data/datasets
MAX_DATASET_SIZE_MB=1000
SUPPORTED_FORMATS=json,csv,parquet

# AI Features
ENABLE_AUTO_PREPROCESSING=True
DEFAULT_AI_FORMAT=parquet
